# 端口配置
WEB_PORT=80
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
KAFKA_PORT=9092

# ClickHouse数据库
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=bilibili
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=1145141919810

# Kafka消息队列
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=bilibili-comments
KAFKA_NODE_ID=1

# 数据处理(多少个评论插入数据库)
BATCH_SIZE=50000

# 日志
LOG_LEVEL=INFO

# 时区
TZ=Asia/Shanghai

# 爬虫默认延迟配置
DEFAULT_MIN_DELAY=1.0
DEFAULT_MAX_DELAY=3.0